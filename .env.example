# 專案環境變數設定範例
# 複製此檔案為 .env 並調整設定：cp .env.example .env

PROJECT_NAME="Fred's POS Backend"
API_V1_STR="/api/v1"
DEBUG=True

# 資料庫連線設定 (預設使用本地 SQLite)
SQLALCHEMY_DATABASE_URI="sqlite:///./freds_pos.db"

# 伺服器監聽設定
HOST=0.0.0.0
PORT=8000

# CORS 允許來源（白名單：指允許造訪此 BE 的「前端 (FE)」網址，如 Vite 預設 5173、靜態伺服器 3000）
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Google OAuth user client id（可逗號分隔多個）。只放在伺服器。不要把 client secret 放到前端。
# 未設定時，登入會拒絕，不會放行。
GOOGLE_CLIENT_ID=

# 白名單是空的時候，啟動或第一次登入會寫入這一位管理員，之後就不再看這個變數。
# 不要填前端示範信箱。顯示名稱空白時用 email。
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_NAME=

# 測試或預覽部署可跳過登入，直接呼叫需登入的 API。預設 false。
# ENVIRONMENT（不分大小寫）或 VERCEL_ENV 為 production 時一律忽略，登入規則不變。
# 開啟後，沒有有效 session 的請求會被視為固定的測試管理員，不會寫進白名單。
# 公開網址開啟此旗標等於開放 API。
SKIP_LOGIN=false

# SKIP_LOGIN 生效時綁定的門市名稱。空白則用名稱排序後的第一間既有門市。
# 指定的門市不存在，或完全沒有門市時，需要門市的 API 仍回 AUTH_STORE_REQUIRED。
SKIP_LOGIN_STORE=

# 正式環境請設 DEBUG=false。DEBUG=true 時 SQL 與 500 回應會比較詳細。
# DEBUG=false
